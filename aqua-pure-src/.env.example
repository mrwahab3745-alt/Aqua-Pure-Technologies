# Copy to .env.local for local dev. In Vercel add the same names under Settings -> Environment Variables.
# Public Web3Forms access key (get it free at web3forms.com using the shop's email)
NEXT_PUBLIC_WEB3FORMS_KEY=
# Published-to-web CSV link of the spare-parts Google Sheet (see PARTS-SHEET-GUIDE.md)
PARTS_SHEET_CSV_URL=
# Final domain, no trailing slash (used for SEO/sitemap). Leave empty until the domain is connected.
NEXT_PUBLIC_SITE_URL=
